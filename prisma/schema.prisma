// prisma/schema.prisma
// Prisma 7 — a URL é configurada no prisma.config.ts, não aqui

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── HOME PAGE ───────────────────────────────────────────────────────────────

model HeroSlide {
  id        Int      @id @default(autoincrement())
  order     Int      @default(0)
  tag       String
  line1     String
  line2     String
  line3     String
  sub       String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_slides")
}

