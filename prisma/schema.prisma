generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HeroSlide {
  id        Int      @id @default(autoincrement())
  order     Int
  tag       String
  line1     String
  line2     String
  line3     String
  sub       String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  image     String?

  @@map("hero_slides")
}

model Product {
  id         Int      @id @default(autoincrement())
  slug       String
  order      Int
  name       String
  desc       String
  color      String
  lightColor String
  specs      String[]
  brands     String[]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  iconIndex  Int

  @@map("products")
}

model PresencePoint {
  id        Int      @id @default(autoincrement())
  order     Int      @default(0)
  name      String
  lon       Float
  lat       Float
  isMain    Boolean  @default(false)
  detail    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("presence_points")
}

model ContactOffice {
  id        Int      @id @default(autoincrement())
  order     Int      @default(0)
  country   String
  flag      String
  address   String
  phones    String[]
  email     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_offices")
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  label     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model Service {
  id        Int      @id @default(autoincrement())
  order     Int      @default(0)
  title     String
  short     String
  iconIndex Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model Client {
  id        Int      @id @default(autoincrement())
  order     Int      @default(0)
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Brand {
  id        Int      @id @default(autoincrement())
  order     Int      @default(0)
  name      String
  role      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model Presence {
  id        Int      @id @default(autoincrement())
  order     Int      @default(0)
  name      String
  lon       Float
  lat       Float
  main      Boolean  @default(false)
  detail    String
  flag      String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
