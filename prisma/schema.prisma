model Product {
  id        Int      @id @default(autoincrement())
  order     Int      @default(0)
  slug      String   @unique
  name      String
  desc      String
  color     String   @default("#095b66")
  lightColor String  @default("#e8f7f9")
  specs     String[] 
  brands    String[]
  iconIndex Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Service {
  id        Int      @id @default(autoincrement())
  order     Int      @default(0)
  title     String
  short     String   @db.Text
  iconIndex Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model Client {
  id        Int      @id @default(autoincrement())
  order     Int      @default(0)
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Brand {
  id        Int      @id @default(autoincrement())
  order     Int      @default(0)
  name      String
  role      String
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model PresencePoint {
  id        Int      @id @default(autoincrement())
  order     Int      @default(0)
  name      String
  lon       Float
  lat       Float
  isMain    Boolean  @default(false)
  detail    String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("presence_points")
}

model ContactOffice {
  id        Int      @id @default(autoincrement())
  order     Int      @default(0)
  country   String
  flag      String
  address   String   @db.Text
  phones    String[]
  email     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_offices")
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  label     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
